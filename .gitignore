node_modules/
frontend/node_modules/
*.tmp
.venv/
venv/
__pycache__/
*.pyc

# session data — keep folder names, not profiles / cookies / store
/data/*
!/data/.gitkeep
!/data/profiles/
/data/profiles/*
!/data/profiles/.gitkeep
!/data/cookies/
/data/cookies/*
!/data/cookies/.gitkeep
/data/webview_profile/*

# generated sheets (include proxies)
/updates/*
!/updates/.gitkeep

# dumps — keep folder names, not proxy / fingerprint / account data
/resources/AccountFile.csv
/resources/proxies/*
!/resources/proxies/.gitkeep
/resources/fpts/*
!/resources/fpts/.gitkeep

# packaging output (npm run stage / build:setup)
/build/
/release/

# throwaway bundle of launcher + node_modules (76 MB) — never commit
/launcher.zip
